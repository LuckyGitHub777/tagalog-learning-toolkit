{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tagalog.academy/data/lesson.schema.json",
  "title": "Tagalog Academy lesson",
  "type": "object",
  "required": [
    "version",
    "id",
    "order",
    "title",
    "summary",
    "objectives",
    "vocabulary",
    "grammar_notes",
    "patterns",
    "builders",
    "mission",
    "resources"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "content_status": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "tagalog",
          "english",
          "accepted",
          "kind",
          "register",
          "practice"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tagalog": {
            "type": "string"
          },
          "english": {
            "type": "string"
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "enum": [
              "word",
              "sentence",
              "question"
            ]
          },
          "register": {
            "type": "string"
          },
          "practice": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "exercise_english": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "grammar_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "body"
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "tagalog",
          "english"
        ]
      }
    },
    "builders": {
      "type": "array",
      "minItems": 1
    },
    "mission": {
      "type": "object",
      "required": [
        "title",
        "description",
        "steps",
        "example"
      ]
    },
    "resources": {
      "type": "array"
    }
  }
}

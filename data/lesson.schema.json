{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tagalog.academy/data/lesson.schema.json",
  "title": "Tagalog Academy Lesson",
  "type": "object",
  "required": [
    "version",
    "id",
    "week",
    "title",
    "short_title",
    "subtitle",
    "objectives",
    "vocabulary",
    "grammar_notes",
    "sentence_patterns",
    "builders",
    "quiz",
    "missions",
    "resources"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^week[1-9][0-9]*$"
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "short_title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "tagalog",
          "english",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tagalog": {
            "type": "string"
          },
          "english": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "grammar_notes": {
      "type": "array"
    },
    "sentence_patterns": {
      "type": "array"
    },
    "builders": {
      "type": "array",
      "minItems": 2
    },
    "quiz": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10
    },
    "missions": {
      "type": "array",
      "minItems": 2
    },
    "resources": {
      "type": "array"
    }
  }
}

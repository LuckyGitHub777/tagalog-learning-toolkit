{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tagalog-learning-toolkit/lesson.schema.json",
  "title": "Tagalog Learning Toolkit lesson",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "vocabulary",
    "adjectives",
    "quiz"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "tagalog",
          "english",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "tagalog": {
            "type": "string",
            "minLength": 1
          },
          "english": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "accepted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "adjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tagalog",
          "english"
        ],
        "properties": {
          "tagalog": {
            "type": "string"
          },
          "english": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question",
          "choices",
          "answer",
          "explanation"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}

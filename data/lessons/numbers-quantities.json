  "grammar_notes": [
    {
      "title": "Assimilated spellings",
      "body": "The standard forms include labindalawa, labintatlo, labinlima, labimpito, and labinsiyam."
    },
    {
      "title": "Number linkers",
      "body": "Number words change before nouns: dalawa → dalawang, lima → limang, apat → apat na."
    }
  ],
  "patterns": [
    {
      "title": "Ask quantity",
      "tagalog": "Ilang [bagay]?",
      "english": "How many [things]?"
    },
    {
      "title": "Answer quantity",
      "tagalog": "Limang [bagay].",
      "english": "Five [things]."
    }
  ],

  "grammar_notes": [
    {
      "title": "Preferences",
      "body": "Use “Gusto ko ng…” for something you like or want, and “Ayaw ko ng…” for something you do not like or want."
    },
    {
      "title": "Color linkers",
      "body": "Some color forms connect with -ng; others use “na”. Learn complete examples rather than guessing."
    }
  ],
  "patterns": [
    {
      "title": "Favorite color",
      "tagalog": "[Kulay] ang paborito kong kulay.",
      "english": "[Color] is my favorite color."
    },
    {
      "title": "Colored object",
      "tagalog": "Pulang tasa. / Asul na tasa.",
      "english": "Red cup. / Blue cup."
    }
  ],
  "builders": [
    {
      "id": "color-object",
      "title": "Describe a colored object",
      "description": "Practice color + linker + object.",
      "template": "{{phrase}} ang {{object}} ko.",
      "fields": [
        {
          "name": "phrase",
          "label": "Color form",
          "type": "select",
          "options": [
            "Pula",
            "Asul",
            "Berde",
            "Dilaw",
            "Itim",
            "Puti",
            "Lila",
            "Rosas",
            "Kahel"
          ]
        },
        {
          "name": "object",
          "label": "Object",
          "type": "text",
          "placeholder": "tasa"
        }
      ],
      "note": "After generating, revise the color with the correct linker: pulang tasa, berdeng tasa, or asul na tasa."
    }
  ],
  "mission": {
    "title": "Color hunt",
    "description": "Find and describe five objects around you.",
    "steps": [

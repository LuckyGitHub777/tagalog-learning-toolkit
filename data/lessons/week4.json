  "grammar_notes": [
    {
      "title": "Ilan or ilang",
      "body": "Ilan asks how many by itself. Ilang comes before a noun.",
      "examples": [
        {
          "tagalog": "Ilan?",
          "english": "How many?"
        },
        {
          "tagalog": "Ilang mangga?",
          "english": "How many mangoes?"
        }
      ]
    },
    {
      "title": "Number linkers",
      "body": "A number often connects to the noun with -ng or na. This creates forms such as limang mangga and dalawampung piso.",
      "examples": [
        {
          "tagalog": "Limang mangga",
          "english": "Five mangoes"
        },
        {
          "tagalog": "Dalawampung piso",
          "english": "Twenty pesos"
        }
      ]
    },
    {
      "title": "Introducing a relationship",
      "body": "Use Ito si + name to introduce a person, followed by relationship + ko siya.",
      "examples": [
        {
          "tagalog": "Ito si Ana. Kaibigan ko siya.",
          "english": "This is Ana. She is my friend."
        },
        {
          "tagalog": "Ito si Leo. Katrabaho ko siya.",
          "english": "This is Leo. He is my coworker."
        }
      ]
    }
  ],
  "sentence_patterns": [
    {
      "title": "Ask a price",
      "pattern": "Magkano ang [prutas]?",
      "english": "How much is the [fruit]?"
    },
    {
      "title": "Ask a quantity",
      "pattern": "Ilang [bagay]?",
      "english": "How many [things]?"
    },
    {
      "title": "Introduce a person",
      "pattern": "Ito si [pangalan]. [Ugnayan] ko siya.",
      "english": "This is [name]. They are my [relationship]."
    }
  ],
  "builders": [
    {
      "id": "market-dialogue",
      "title": "Build a market exchange",
      "description": "Create a short fruit-buying dialogue.",
      "template": "Mamimili: Kumusta po! Pabili po ng {{fruit}}.\nTindero: Ilan ang gusto mo?\nMamimili: {{quantity}} {{fruit}} po.\nMamimili: Magkano po?\nTindero: {{price}} piso bawat isa.\nMamimili: Sige po. Salamat!",
      "fields": [
        {
          "name": "fruit",
          "label": "Fruit",
          "type": "select",
          "options": [
            "mangga",
            "saging",
            "mansanas",
            "dalandan",
            "ubas",
            "pinya",
            "papaya"
          ]
        },
        {
          "name": "quantity",
          "label": "Quantity phrase",
          "type": "select",
          "options": [
            "Dalawang",
            "Tatlong",
            "Apat na",
            "Limang",
            "Anim na"
          ]
        },
        {
          "name": "price",
          "label": "Price",
          "type": "select",
          "options": [
            "sampung",
            "dalawampung",
            "tatlumpung",
            "limampung"
          ]
        }
      ]
    },
    {
      "id": "people-introduction",
      "title": "Introduce someone in your life",
      "description": "Use a relationship and an adjective.",
      "template": "Ito si {{name}}. {{relationship}} ko siya. {{adjective}} siya.",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "placeholder": "Maria"
        },
        {
          "name": "relationship",
          "label": "Relationship",
          "type": "select",
          "options": [
            "Kaibigan",
            "Katrabaho",
            "Kasamahan",
            "Kakilala",
            "Kapitbahay",
            "Kababayan"
          ]
        },
        {
          "name": "adjective",
          "label": "Adjective",
          "type": "select",
          "options": [
            "Mabait",
            "Matalino",
            "Masipag",
            "Masayahin",
            "Palakaibigan",
            "Matulungin",
            "Tahimik",
            "Nakakatawa"
          ]
        }
      ]
    }
  ],

  "missions": [
    {
      "title": "Market role-play",
      "description": "Pretend to buy at least five fruits from a market.",
      "steps": [
        "Open with a polite greeting.",
        "Ask for at least five fruits.",
        "Use Ilan or ilang for quantity.",
        "Ask the price with Magkano.",
        "Ask Magkano lahat? and close politely."
      ],
      "example": "Pabili po ng mangga. Ilan ang gusto mo? Limang mangga po. Magkano po? Dalawampung piso bawat isa."
    },
    {
      "title": "Introduce five people",
      "description": "Introduce five people using relationship words and adjectives.",
      "steps": [
        "Use Ito si + name.",
        "Use five different relationship words.",
        "Describe each person with one adjective.",
        "Practice the full set aloud.",
        "End with Salamat po! Paalam!"
      ],
      "example": "Ito si Maria. Kaibigan ko siya. Mabait siya."
    }
  ],

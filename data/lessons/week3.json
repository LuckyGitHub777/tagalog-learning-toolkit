  "grammar_notes": [
    {
      "title": "Nasaan and nasa",
      "body": "Use nasaan to ask where someone or something is. Use nasa + place to answer.",
      "examples": [
        {
          "tagalog": "Nasaan ang tasa?",
          "english": "Where is the cup?"
        },
        {
          "tagalog": "Nasa kusina ang tasa.",
          "english": "The cup is in the kitchen."
        },
        {
          "tagalog": "Nasaan si Ana?",
          "english": "Where is Ana?"
        },
        {
          "tagalog": "Nasa sala si Ana.",
          "english": "Ana is in the living room."
        }
      ]
    },
    {
      "title": "Ang versus si",
      "body": "Use ang with common nouns and si with a personal name.",
      "examples": [
        {
          "tagalog": "Nasaan ang kutsara?",
          "english": "Where is the spoon?"
        },
        {
          "tagalog": "Nasaan si Miguel?",
          "english": "Where is Miguel?"
        }
      ]
    },
    {
      "title": "Possession with ko",
      "body": "Ko can mark something as mine in simple identity statements.",
      "examples": [
        {
          "tagalog": "Kwarto ko ito.",
          "english": "This is my room."
        },
        {
          "tagalog": "Tasa ko ito.",
          "english": "This is my cup."
        }
      ]
    }
  ],
  "sentence_patterns": [
    {
      "title": "Ask for an object",
      "pattern": "Nasaan ang [bagay]?",
      "english": "Where is the [object]?"
    },
    {
      "title": "Give an object location",
      "pattern": "Nasa [lugar] ang [bagay].",
      "english": "The [object] is in the [place]."
    },
    {
      "title": "Ask for a person",
      "pattern": "Nasaan si [pangalan]?",
      "english": "Where is [name]?"
    }
  ],

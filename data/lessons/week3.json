  "missions": [
    {
      "title": "One-minute house tour",
      "description": "Give a simple tour of a room or home.",
      "steps": [
        "Introduce at least three places.",
        "Name at least five objects.",
        "Ask three Nasaan ang...? questions.",
        "Answer each question with Nasa... ang....",
        "End with Salamat!"
      ],
      "example": "Ito ang kusina. Nasa kusina ang plato. Nasaan ang tasa? Nasa kusina ang tasa."
    },
    {
      "title": "Find it",
      "description": "Choose five household objects and practice asking and answering where each one is.",
      "steps": [
        "Choose five different objects.",
        "Ask Nasaan ang...? for each item.",
        "Answer with a different room when possible.",
        "Say the exchange aloud twice.",
        "Try one person-location example with si."
      ],
      "example": "Nasaan ang kutsilyo? Nasa kusina ang kutsilyo."
    }
  ],

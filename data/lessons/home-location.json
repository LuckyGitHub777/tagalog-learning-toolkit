  "grammar_notes": [
    {
      "title": "Objects and people",
      "body": "Use “ang” for an object and “si” before a person’s name."
    },
    {
      "title": "Location",
      "body": "Ask with “Nasaan…?” and answer with “Nasa…”."
    },
    {
      "title": "Possession",
      "body": "Use “ko” after a noun to mean “my”, as in “tasa ko”."
    }
  ],
  "patterns": [
    {
      "title": "Ask for an object",
      "tagalog": "Nasaan ang [bagay]?",
      "english": "Where is the [object]?"
    },
    {
      "title": "Give an object location",
      "tagalog": "Nasa [lugar] ang [bagay].",
      "english": "The [object] is in the [place]."
    },
    {
      "title": "Ask for a person",
      "tagalog": "Nasaan si [pangalan]?",
      "english": "Where is [name]?"
    }
  ],
  "builders": [
    {
      "id": "location-builder",
      "title": "Build a location question and answer",
      "description": "Choose an object and a room.",
      "template": "Nasaan ang {{object}}?\nNasa {{place}} ang {{object}}.",
      "fields": [
        {
          "name": "object",
          "label": "Object",
          "type": "select",
          "options": [
            "kutsara",
            "plato",
            "tasa",
            "kama",
            "unan",
            "sabon",
            "sipilyo",
            "tuwalya",

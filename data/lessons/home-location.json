    },
    {
      "id": "person-location",
      "title": "Build a person-location exchange",
      "description": "Practice si with a name.",
      "template": "Nasaan si {{name}}?\nNasa {{place}} si {{name}}.",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "placeholder": "Ana"
        },
        {
          "name": "place",
          "label": "Place",
          "type": "text",
          "placeholder": "sala"
        }
      ]
    }
  ],
  "mission": {
    "title": "Describe a room",
    "description": "Give a short tour of one room.",
    "steps": [
      "Name the room.",
      "Name five objects.",
      "Ask two “Nasaan…?” questions.",
      "Answer each question."
    ],
    "example": "Ito ang kusina. Nasa kusina ang plato. Nasaan ang tasa? Nasa kusina ang tasa."
  },

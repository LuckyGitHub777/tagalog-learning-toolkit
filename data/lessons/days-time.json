  "grammar_notes": [
    {
      "title": "Ala and alas",
      "body": "Use “ala una” for one o’clock and “alas” before the other Spanish-derived hour forms."
    },
    {
      "title": "Schedules",
      "body": "Use “Tuwing + day” for a recurring day."
    },
    {
      "title": "Context",
      "body": "“Ngayon” can mean “now” or “today” depending on the sentence."
    }
  ],
  "patterns": [
    {
      "title": "Ask the day",
      "tagalog": "Anong araw ngayon?",
      "english": "What day is it today?"
    },
    {
      "title": "Ask the time",
      "tagalog": "Anong oras na?",
      "english": "What time is it?"
    },
    {
      "title": "Recurring schedule",
      "tagalog": "Tuwing Lunes, alas tres ang klase ko.",
      "english": "Every Monday, my class is at three."
    }
  ],
  "builders": [
    {
      "id": "schedule-builder",
      "title": "Build a schedule sentence",
      "description": "Say when an activity happens.",
      "template": "Tuwing {{day}}, {{time}} ang {{activity}} ko.",
      "fields": [
        {
          "name": "day",
          "label": "Day",
          "type": "select",
          "options": [
            "Lunes",
            "Martes",
            "Miyerkules",
            "Huwebes",
            "Biyernes",
            "Sabado",
            "Linggo"
          ]
        },
        {
          "name": "time",
          "label": "Time",
          "type": "select",
          "options": [
            "ala una",
            "alas dos",
            "alas tres",
            "alas kuwatro",
            "alas singko",
            "alas sais",
            "alas siyete",
            "alas otso"
          ]
        },
        {
          "name": "activity",
          "label": "Activity",
          "type": "text",
          "placeholder": "klase"
        }
      ]
    }
  ],
  "mission": {
    "title": "Describe your schedule",
    "description": "Say what happens on five days.",
    "steps": [
      "Say what day it is today.",
      "Use five different day names.",
      "Use three different times.",
      "Read the schedule aloud."
    ],
    "example": "Lunes ngayon. Tuwing Martes, alas dos ang klase ko."
  },

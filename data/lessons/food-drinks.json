  "grammar_notes": [
    {
      "title": "Food preferences",
      "body": "Use “Gusto ko ng + food or drink” and “Ayaw ko ng + food or drink”."
    },
    {
      "title": "Questions",
      "body": "“Ano ang gusto mong kainin?” asks what someone wants to eat; “inumin” asks what they want to drink."
    }
  ],
  "patterns": [
    {
      "title": "Favorite food",
      "tagalog": "[Pagkain] ang paborito kong pagkain.",
      "english": "[Food] is my favorite food."
    },
    {
      "title": "What you want",
      "tagalog": "Gusto ko ng [pagkain o inumin].",
      "english": "I want or like [food or drink]."
    }
  ],
  "builders": [
    {
      "id": "favorite-things",
      "title": "Build your favorite-things introduction",
      "description": "Create four sentences about your preferences.",
      "template": "{{color}} ang paborito kong kulay. {{food}} ang paborito kong pagkain. Gusto ko ng {{drink}}. Ayaw ko ng {{dislike}}.",
      "fields": [
        {
          "name": "color",
          "label": "Favorite color",
          "type": "select",
          "options": [
            "Pula",
            "Asul",
            "Berde",
            "Dilaw",
            "Itim",
            "Puti",
            "Lila",
            "Rosas",
            "Kahel"
          ]
        },
        {
          "name": "food",
          "label": "Favorite food",
          "type": "text",
          "placeholder": "adobo"
        },
        {
          "name": "drink",
          "label": "Preferred drink",
          "type": "select",
          "options": [
            "tubig",
            "kape",
            "tsaa",
            "gatas"
          ]
        },
        {
          "name": "dislike",
          "label": "Food you dislike",
          "type": "text",
          "placeholder": "isda"
        }
      ]
    }
  ],
  "mission": {
    "title": "Talk about your preferences",
    "description": "Say four sentences about food and drinks.",
    "steps": [
      "Name your favorite food.",
      "Name a drink you like.",
      "Name one food you do not like.",
      "Read the four sentences aloud."
    ],
    "example": "Adobo ang paborito kong pagkain. Gusto ko ng kape. Ayaw ko ng isda."
  },

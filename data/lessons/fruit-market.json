  "grammar_notes": [
    {
      "title": "Price",
      "body": "Use “Magkano ang…?” to ask the price of one item and “Magkano lahat?” to ask the total."
    },
    {
      "title": "Politeness",
      "body": "Use “po” in a respectful exchange."
    },
    {
      "title": "Dalandan and kahel",
      "body": "Dalandan names a citrus fruit; kahel is a color term."
    }
  ],
  "patterns": [
    {
      "title": "Ask a price",
      "tagalog": "Magkano ang [prutas]?",
      "english": "How much is the [fruit]?"
    },
    {
      "title": "Buy something",
      "tagalog": "Pabili po ng [prutas].",
      "english": "I would like to buy [fruit], please."
    }
  ],
  "builders": [
    {
      "id": "market-dialogue",
      "title": "Build a market exchange",
      "description": "Create a short fruit-buying dialogue.",
      "template": "Mamimili: Kumusta po! Pabili po ng {{fruit}}.\nTindero: Ilan ang gusto mo?\nMamimili: {{quantity}} {{fruit}} po.\nMamimili: Magkano po?\nTindero: {{price}} piso bawat isa.\nMamimili: Sige po. Salamat!",
      "fields": [
        {
          "name": "fruit",
          "label": "Fruit",
          "type": "select",
          "options": [
            "mangga",
            "saging",
            "mansanas",
            "dalandan",
            "ubas",
            "pinya",
            "papaya"
          ]
        },
        {
          "name": "quantity",
          "label": "Quantity phrase",
          "type": "select",
          "options": [
            "Dalawang",
            "Tatlong",
            "Apat na",
            "Limang",
            "Anim na"
          ]
        },
        {
          "name": "price",
          "label": "Price",
          "type": "select",
          "options": [
            "sampung",
            "dalawampung",
            "tatlumpung",
            "limampung"
          ]
        }
      ]
    }
  ],
  "mission": {
    "title": "Market conversation",
    "description": "Practice a short buyer-and-seller exchange.",
    "steps": [
      "Greet politely.",
      "Ask to buy a fruit.",
      "State a quantity.",

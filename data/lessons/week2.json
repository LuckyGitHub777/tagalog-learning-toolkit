  "grammar_notes": [
    {
      "title": "Gusto and ayaw",
      "body": "Use gusto ko ng + noun for something you like or want. Use ayaw ko ng + noun for something you do not like or want.",
      "examples": [
        {
          "tagalog": "Gusto ko ng kape.",
          "english": "I like or want coffee."
        },
        {
          "tagalog": "Ayaw ko ng isda.",
          "english": "I do not like or want fish."
        }
      ]
    },
    {
      "title": "Color linkers",
      "body": "Many color words connect to a noun with -ng or na. Vowel-ending colors often take -ng; some consonant-ending forms use na.",
      "examples": [
        {
          "tagalog": "Pulang kotse",
          "english": "Red car"
        },
        {
          "tagalog": "Berdeng sapatos",
          "english": "Green shoes"
        },
        {
          "tagalog": "Asul na bahay",
          "english": "Blue house"
        },
        {
          "tagalog": "Itim na damit",
          "english": "Black clothing"
        }
      ]
    }
  ],
  "sentence_patterns": [
    {
      "title": "Favorite color",
      "pattern": "[Kulay] ang paborito kong kulay.",
      "english": "[Color] is my favorite color."
    },
    {
      "title": "Like or want",
      "pattern": "Gusto ko ng [bagay o pagkain].",
      "english": "I like or want [thing or food]."
    },
    {
      "title": "Dislike",
      "pattern": "Ayaw ko ng [bagay o pagkain].",
      "english": "I do not like or want [thing or food]."
    }
  ],

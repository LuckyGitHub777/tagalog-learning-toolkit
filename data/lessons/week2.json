  "missions": [
    {
      "title": "Favorite things challenge",
      "description": "Rehearse or record a one-minute talk about colors and food.",
      "steps": [
        "Greet the listener.",
        "Name your favorite color.",
        "Name your favorite food and drink.",
        "Mention one food you do not like.",
        "End with thanks and a goodbye."
      ],
      "example": "Kumusta! Asul ang paborito kong kulay. Adobo ang paborito kong pagkain. Gusto ko ng kape. Ayaw ko ng isda. Salamat! Paalam!"
    },
    {
      "title": "Color hunt",
      "description": "Find five objects around you and identify their colors.",
      "steps": [
        "Choose five objects.",
        "Say the color and object for each one.",
        "Use at least two -ng color forms.",
        "Use at least two na color forms.",
        "Say which object is your favorite."
      ],
      "example": "Pulang tasa ito. Asul na telepono ito."
    }
  ],

  "quiz": [
    {
      "question": "What does pula mean?",
      "choices": [
        "Blue",
        "Red",
        "Yellow",
        "Black"
      ],
      "answer": 1,
      "explanation": "Pula means red."
    },
    {
      "question": "Which phrase asks for someone's favorite color?",
      "choices": [
        "Anong kulay ito?",
        "Ano ang paborito mong kulay?",
        "Ano ang gusto mong kainin?",
        "Gusto mo ba ng berde?"
      ],
      "answer": 1,
      "explanation": "Paborito mong kulay means your favorite color."
    },
    {
      "question": "How do you say 'I like blue'?",
      "choices": [
        "Ayaw ko ng asul.",
        "Gusto ko ng asul.",
        "Asul ang ayaw ko.",
        "May asul ako."
      ],
      "answer": 1,
      "explanation": "Gusto ko ng + noun expresses liking or wanting."
    },
    {
      "question": "Which word means rice?",
      "choices": [
        "Kanin",
        "Tinapay",
        "Isda",
        "Tubig"
      ],
      "answer": 0,
      "explanation": "Kanin means cooked rice."
    },
    {
      "question": "What does 'Ano ang gusto mong inumin?' ask?",

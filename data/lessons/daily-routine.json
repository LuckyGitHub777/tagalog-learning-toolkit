  "grammar_notes": [
    {
      "title": "Completed aspect",
      "body": "Forms such as “nagsipilyo”, “naligo”, and “nagbihis” describe completed actions in this lesson."
    },
    {
      "title": "Time marker",
      "body": "Use “ng + time” after the action, as in “Gumising ako ng alas sais.”"
    },
    {
      "title": "Sequence",
      "body": "Use “pagkatapos” to refer to what happened next."
    }
  ],
  "patterns": [
    {
      "title": "Completed action",
      "tagalog": "Nagsipilyo ako.",
      "english": "I brushed my teeth."
    },
    {
      "title": "Action with time",
      "tagalog": "Gumising ako ng alas sais.",
      "english": "I woke up at six o’clock."
    },
    {
      "title": "Ask what came next",
      "tagalog": "Ano ang ginawa mo pagkatapos?",
      "english": "What did you do next?"
    }
  ],
  "builders": [
    {
      "id": "routine-builder",
      "title": "Build a morning routine",
      "description": "Create a short routine you can say aloud.",
      "template": "Gumising ako ng {{wake}}. {{action1}} {{action2}} Nag-almusal ako ng {{breakfast}}. Pumasok ako sa {{destination}} ng {{leave}}.",
      "fields": [
        {
          "name": "wake",
          "label": "Wake-up time",
          "type": "select",
          "options": [
            "alas singko",
            "alas sais",
            "alas siyete"
          ]
        },
        {
          "name": "action1",
          "label": "First action",
          "type": "select",
          "options": [
            "Nagsipilyo ako.",
            "Naghilamos ako.",
            "Naligo ako."
          ]
        },
        {
          "name": "action2",
          "label": "Next action",
          "type": "select",
          "options": [
            "Nagbihis ako.",
            "Nagsuklay ako.",
            "Uminom ako ng tubig."
          ]
        },
        {
          "name": "breakfast",
          "label": "Breakfast time",
          "type": "select",
          "options": [
            "alas sais",
            "alas siyete",
            "alas otso"
          ]
        },
        {
          "name": "destination",
          "label": "Destination",
          "type": "select",
          "options": [
            "trabaho",
            "paaralan"
          ]
        },
        {
          "name": "leave",
          "label": "Arrival time",
          "type": "select",
          "options": [
            "alas siyete",
            "alas otso",
            "alas nuwebe"
          ]
        }
      ]
    }
  ],
  "mission": {
    "title": "Describe your routine",
    "description": "Say eight completed actions in order.",
    "steps": [
      "Start with when you woke up.",
      "Use at least eight completed actions.",
      "Mention three times.",
      "End with going to work or school."
    ],
    "example": "Gumising ako ng alas sais. Nagsipilyo ako. Naghilamos ako. Naligo ako. Nag-almusal ako ng alas siyete."
  },

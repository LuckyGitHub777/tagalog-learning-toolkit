  "grammar_notes": [
    {
      "title": "Names",
      "body": "Use “Ako si + name” to introduce yourself."
    },
    {
      "title": "Place of origin",
      "body": "Use “Taga- + place + ako” to say where you are from."
    },
    {
      "title": "Respect",
      "body": "Add “po” in respectful conversation when appropriate."
    }
  ],
  "patterns": [
    {
      "title": "Introduce yourself",
      "tagalog": "Ako si [pangalan].",
      "english": "I am [name]."
    },
    {
      "title": "Say where you are from",
      "tagalog": "Taga-[lugar] ako.",
      "english": "I am from [place]."
    },
    {
      "title": "Say how you feel",
      "tagalog": "[Pakiramdam] ako.",
      "english": "I am [feeling]."
    }
  ],
  "builders": [
    {
      "id": "self-introduction",
      "title": "Build a self-introduction",
      "description": "Create a short introduction you can read aloud.",
      "template": "Kumusta! Ako si {{name}}. Taga-{{place}} ako. {{feeling}} ako. {{role}} ako. Salamat! Paalam!",
      "fields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "placeholder": "Maya"
        },
        {
          "name": "place",
          "label": "Place",
          "type": "text",
          "placeholder": "Cebu"
        },
        {
          "name": "feeling",
          "label": "Feeling",
          "type": "select",
          "options": [
            "Masaya",
            "Ayos lang",
            "Pagod",
            "Nasasabik"
          ]
        },
        {
          "name": "role",
          "label": "Role or occupation",
          "type": "text",
          "placeholder": "Estudyante"
        }
      ]
    }
  ],
  "mission": {
    "title": "Introduce yourself",
    "description": "Say a short introduction aloud.",
    "steps": [
      "Greet the listener.",
      "Say your name.",
      "Say where you are from.",
      "Mention work, study, or an interest.",
      "End with thanks and a goodbye."
    ],
    "example": "Kumusta! Ako si Maya. Taga-Cebu ako. Estudyante ako. Salamat! Paalam!"
  },

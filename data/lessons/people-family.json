  "grammar_notes": [
    {
      "title": "Personal names",
      "body": "Use “si” before a person’s name."
    },
    {
      "title": "Relationships",
      "body": "Use “[relationship] ko siya” to say how someone is related to you."
    },
    {
      "title": "Descriptions",
      "body": "Use “[adjective] siya” to describe a person."
    }
  ],
  "patterns": [
    {
      "title": "Introduce someone",
      "tagalog": "Ito si [pangalan]. [Ugnayan] ko siya.",
      "english": "This is [name]. They are my [relationship]."
    },
    {
      "title": "Describe someone",
      "tagalog": "[Pang-uri] siya.",
      "english": "They are [adjective]."
    }
  ],
